type Item { name str, tags []str }

fn longest(items []Item) str {
    mut best := 0
    for it, i in items {
        if len(it.name) > len(items[best].name) { best = i }
    }
    n := items[best].name
    ret copy(n)
}

fn main() {
    syms := ["M", "CD", "X"]
    for i in 0..len(syms) {
        s := syms[i]
        print("{s}{s}")
    }
    mut a []Item = []
    push(&a, Item{"pen", ["blue"]})
    push(&a, Item{"marker", ["red", "wide"]})
    for _ in 0..1 {
        first := a[1]
        tag := first.tags[1]
        name := first.name
        part := name[1..3]
        print("{tag} {part} {len(first.tags)}")
    }
    push(&a, Item{"x", []})
    print(len(a))
    print(longest(a))
    t := a[0].tags
    print(t)
    tail := syms[1..]
    print(len(tail))
}
// expect: MM
// expect: CDCD
// expect: XX
// expect: wide ar 2
// expect: 3
// expect: marker
// expect: [blue]
// expect: 2
