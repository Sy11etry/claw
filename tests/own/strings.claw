// allocs-at-least: 2
fn count(s str, c u8) int {
    mut n := 0
    for x in s {
        if x == c { n += 1 }
    }
    ret n
}

fn main() {
    s := "hello"
    print(s)
    print(len(s))
    print(s[1])
    print(s[1..3])
    print(count(s, 'l'))
    print(s == "hello")
    print(s != "world")
    print(s == "hell")
    print("abc" < "abd")
    print("b" > "abc")
    print("" < "a")
    print("a" <= "a")
    t := "{s} world {1 + 2}"
    print(t)
    print(len(t))
    for c, i in "ab" { print("{i}:{c}") }
    u := "{t}!"
    print(u)
    e := ""
    print(len(e))
    print(e == "")
    v := "{e}"
    print(len(v))
}
