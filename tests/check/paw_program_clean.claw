// expect: [1, 9, 2]
// expect: [1, 2, 9]
// expect: a-b-c
// expect: ABC
// expect: 3
fn main() {
    mut a []int = [1, 2]
    insert(&a, 1, 9)
    print(a)
    sort(&a)
    print(a)
    p := split("a,b,c", ",")
    print(join(p, "-"))
    print(upper("abc"))
    print(len(p))
    _ = remove(&a, 0)
    clear(&a)
}
