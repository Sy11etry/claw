use c "mylib.h"
use c "stdlib.h"
link "mylib"

claw fn main() {
    p := my_ii_make(7, 2)
    print("{p.a} {p.b}")
    print(my_ii_sum(p))
    d := my_ld_twice(My_ld{3, 2.5})
    print("{d.a} {d.b}")
    s := my_dd_add(My_dd{1.5, 2.5}, My_dd{2.5, 3.5})
    print("{s.x} {s.y}")
    f := my_ffff_scale(My_ffff{1.0, 2.0, 3.0, 4.0}, 2.0)
    print("{f.r} {f.g} {f.b} {f.a}")
    o := my_odd_bump(My_odd{100, 6, 65})
    print("{o.a} {o.b} {o.c}")
    mut t My_12 = My_12{[0...]}
    text := "hello, world"
    for i in 0..12 {
        t.t[i] = text[i]
    }
    u := my_12_upper(t)
    mut out []u8 = []
    for i in 0..12 {
        push(&out, u.t[i])
    }
    print(out)
    b := my_big4_make(5, My_ii{6, 7}, 1.5)
    print("{b.a} {b.b} {b.c} {b.d}")
    print(my_mixed(1, My_dd{2.0, 3.0}, 4, My_ii{5, 6}, 12.0))
    r := div(7, 2)
    print("{r.quot} {r.rem}")
}
