fn f(a int, b int) int
    need b != 0
{
    ret a / b
}

fn main() {
    x := 10
    mut y := x - 7
    unrelated := x * 100
    y -= 3
    print(unrelated)
    print(f(x, y))
}
// expect: FAIL need failed: `b != 0` in f at simple_chain.claw:13:11
// expect: why    simple_chain.claw:8  x := 10    x = 10
// expect:        simple_chain.claw:9  mut y := x - 7    y = 3
// expect:        simple_chain.claw:11  y -= 3    y = 0
// expect:        simple_chain.claw:2  need b != 0
// expect:        simple_chain.claw:13  print(f(x, y))    b = 0
