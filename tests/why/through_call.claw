fn pick(xs []int) int {
    ret xs[len(xs) - 1]
}

fn shift(v int) int {
    ret v - 4
}

fn main() {
    mut xs []int = []
    push(&xs, 4)
    y := pick(xs)
    z := shift(y)
    print(100 / z)
}
// expect: FAIL division by zero at through_call.claw:14:11
