// expect:        through_call.claw:5  fn shift(v int) int {    v = 4
// expect:        through_call.claw:6  ret v - 4
// expect:        through_call.claw:13  z := shift(y)    z = 0
// expect:        through_call.claw:14  print(100 / z)    right = 0
