// expect: 21
// expect: 7.5
// expect: 5.5
// expect: 60
claw fn main_simd() {
    a := alloc[f64](4)
    defer free(a)
    for i in 0..4 { a[i] = f64(i + 1) }
    v := vload(a)                      // lanes 1, 2
    w := vload(a + 2)                  // lanes 3, 4
    s := v + w                         // 4, 6
    t := fma(v, w, s)                  // 1*3+4=7, 2*4+6=14
    print(lane(t, 0) + lane(t, 1))     // 21
    u := f64x2(1.5) * (s - v)          // 1.5 * (3, 4) = 4.5, 6 -> hmm
    print(lane(u, 0) + 3.0)            // 7.5
    vstore(a, u / f64x2(2.0))          // 2.25, 3
    print(lane(vload(a), 0) + lane(vload(a), 1) + 0.25)  // 5.5
    ib := alloc[i32](4)
    defer free(ib)
    for i in 0..4 { ib[i] = i32(i * 10) }
    iv := vload(ib)
    ir := iv + i32x4(5) * iv           // 0, 60, 120, 180
    print(int(lane(ir, 1)))
}

fn main() {
    main_simd()
}
