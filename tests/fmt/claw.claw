pub type Box[T]{ v *T ,n int }

pub claw fn get[T](b *Box[T],i int)T{
  x := b.v[i]*2
 mut p *int=none
 *p=x-1
  q:=&x
  defer free( p )
 ret max[T](*q,x)
}
