fn main() {
    words := split("b a c a b a", " ")
    mut m := new_map[str, int](hash_str)
    for w in words {
        c := get(m, w) else 0
        put(&m, copy(w), c + 1)
    }
    mut keys []str = []
    for e in m.items {
        push(&keys, copy(e.key))
    }
    sort(&keys)
    for k in keys {
        n := get(m, k) else 0
        print("{k} {n}")
    }
}
// expect: a 3
// expect: b 2
// expect: c 1
