// expect: 3.5
// expect: -0.5
// expect: 3
// expect: 0.75
// expect: -1.5
// expect: 2.5
// expect: 0.30000000000000004
// expect: 1000
// expect: 0.0025
// expect: 0.3333333333333333
// expect: true
// expect: true
// expect: false
// expect: false
// expect: true
// expect: false
// expect: 2.5
fn half(x f64) f64 {
    ret x / 2.0
}

fn main() {
    x := 1.5
    y f64 = 2
    print(x + y)
    print(x - y)
    print(x * y)
    print(x / y)
    print(-x)
    print(half(5))
    print(0.1 + 0.2)
    print(1e3)
    print(2.5e-3)
    print(1.0 / 3.0)
    print(x < y)
    print(x <= 1.5)
    print(x > y)
    print(x >= y)
    print(x == 1.5)
    print(x != 1.5)
    mut z f64 = 1
    z += 0.5
    z *= 4
    z -= 1
    z /= 2
    print(z)
}
