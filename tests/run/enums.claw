// expect: 12
// expect: 10
// expect: 0
// expect: Circle{2}
// expect: Rect{2, 5}
// expect: Dot
type Shape = Circle{r f64} | Rect{w f64, h f64} | Dot

fn area(s Shape) f64 {
    match s {
        Circle{r}: ret 3.0 * r * r
        Rect{w, h}: ret w * h
        Dot: ret 0
    }
}

fn main() {
    print(area(Circle{2}))
    print(area(Rect{2, 5}))
    print(area(Dot))
    print(Circle{2})
    print(Rect{2, 5})
    print(Dot)
}
