// expect: 45
// expect: 40
// expect: 7
// expect: 0
fn main() {
    mut sum := 0
    for i in 0..10 { sum += i }
    print(sum)
    for sum > 40 { sum -= 1 }
    print(sum)
    mut n := 0
    for {
        n += 1
        if n == 7 { break }
    }
    print(n)
    mut count := 0
    for _ in 3..3 { count += 1 }
    for _ in 5..2 { count += 1 }
    print(count)
}
