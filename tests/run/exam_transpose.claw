fn main() {
    m [2][3]int = [[1, 2, 3], [4, 5, 6]]
    mut t [3][2]int = [[0, 0], [0, 0], [0, 0]]
    for i in 0..2 {
        for j in 0..3 {
            t[j][i] = m[i][j]
        }
    }
    for j in 0..3 {
        x := t[j][0]
        y := t[j][1]
        print("{x} {y}")
    }
}
// expect: 1 4
// expect: 2 5
// expect: 3 6
