// The length of a string made by `{...}` is only known when it runs.
fn build(n int) str {
    mut s := ""
    for i in 0..n {
        s = "{s}{i}"
    }
    ret s
}

fn main() {
    s := build(3)
    if len(s) > 0 {
        print(s)
    } else {
        print("empty")
    }
    mut clean := ""
    for c in "1_0" {
        if c != '_' { clean = "{clean}{int(c - '0')}" }
    }
    print(len(clean))
}
// expect: 012
// expect: 2
