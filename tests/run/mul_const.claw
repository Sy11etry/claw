fn f3(x int) int { ret x * 3 }
fn f8(x int) int { ret 8 * x }
fn f2(x int) int { ret x * 2 }
fn m9(x u64) u64 { ret x * 9 }
fn m16(x u64) u64 { ret x * 16 }
fn main() {
    ms := [0, 1, -1, 7, -7, 123456789, 3074457345618258602, -3074457345618258602, 1152921504606846975, -1152921504606846976, 2305843009213693951, -2305843009213693952]
