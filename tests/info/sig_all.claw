// expect: fn loud(x int) +io
// expect: fn makes() []int +mem
// expect: pub fn div(a int, b int) int +io
// expect:     need b != 0
// expect:     sure ret * b <= a
// expect: pub fn max[T](a T, b T) T
// expect: fn call(f fn(int, &[]int) int +mem, own s str) ?int
// expect: claw fn raw(p *u8) *u8
// expect: fn main() +mem +io
