// cmd: sig
type Point { x int, y int }
type Shape = Circle{r f64} | Dot
pub type Pair[A, B] { a A, b B }

const limit = 10 * 2
const big int = twice(limit)

fn twice(x int) int {
    ret x * 2
}

fn loud(x int) {
    print(x)
}

fn makes() []int {
    ret [1, 2]
}

pub fn div(a int, b int) int +io
    need b != 0
    sure ret * b <= a
{
    print(big)
    ret a / b
}

pub fn max[T](a T, b T) T {
    if a > b { ret a }
    ret b
}

fn call(f fn(int, &[]int) int +mem, own s str) ?int {
    _ = f
    _ = s
    ret none
}

claw fn raw(p *u8) *u8 {
    ret p
}

test "not shown" {
    loud(1)
}

fn main() {
    _ = makes()
    _ = Point{1, 2}
    _ = Dot
}
