// cmd: ctx total
type Inner { v int }
type Item { name str, inner Inner }
type Unrelated { a int }

const factor = 3
const other = 4

fn weight(it Item) int
    need it.inner.v >= 0
{
    ret it.inner.v * factor
}

fn noise() int {
    print(other)
    ret 0
}

// Adds them all up.
fn total(items []Item) int {
    mut s := 0
    for it in items {
        s += weight(it) * factor
    }
    ret s
}

fn report(items []Item) {
    print(total(items))
}

fn main() {
    a := [Item{"x", Inner{1}}]
    report(a)
    print(total(a) + noise())
    print(Unrelated{1})
}
