// expect: 15
// SIMD by hand: two f64 lanes per instruction (NEON on arm64, SSE on x86-64).
claw fn dot(a *f64, b *f64, n int) f64 {
    mut acc := f64x2(0.0)
    mut i := 0
    for i + 2 <= n {
        acc = fma(vload(a + i), vload(b + i), acc)
        i += 2
    }
    ret lane(acc, 0) + lane(acc, 1)
}

claw fn main() {
    x := alloc[f64](4)
    y := alloc[f64](4)
    defer free(x)
    defer free(y)
    for i in 0..4 {
        x[i] = f64(i + 1)
        y[i] = 1.5
    }
    print(dot(x, y, 4))
}
