// expect: words 5
// expect: longest quick
fn main() {
    text := "the quick brown fox  jumps"
    parts := split(text, " ")
    mut count := 0
    mut best := ""
    for w in parts {
        if len(w) == 0 { continue }
        count += 1
        if len(w) > len(best) { best = copy(w) }
    }
    print("words {count}")
    print("longest {best}")
}
