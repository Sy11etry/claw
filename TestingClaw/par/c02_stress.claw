// expect: total 332833592
// expect: labels 3910
use par

fn square(x int) int {
    ret x * x
}

fn label(x int) str {
    ret "n{x}"
}

fn main() {
    mut total := 0
    mut labels := 0
    for n in [0, 1, 2, 7, 1000] {
        xs := par.build(n, square)
        ls := par.build(n, label)
        for x in xs { total += x }
        for l in ls { labels += len(l) }
    }
    print("total {total}")
    print("labels {labels}")
}
