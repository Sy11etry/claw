// expect: n 0 ints true strs true items true
// expect: n 1 ints true strs true items true
// expect: n 2 ints true strs true items true
// expect: n 7 ints true strs true items true
// expect: n 1000 ints true strs true items true
// expect: n 1000000 ints true strs true items true
use par

type Item { id int, name str }

fn square(x int) int {
    ret x * x
}

fn label(x int) str {
    ret "n{x}"
}

fn make_item(x int) Item {
    ret Item{x, "item"}
}

fn loop_squares(n int) []int {
    mut out []int = []
    for i in 0..n {
        push(&out, square(i))
    }
    ret out
}

fn loop_labels(n int) []str {
    mut out []str = []
    for i in 0..n {
        push(&out, label(i))
    }
    ret out
}

fn loop_items(n int) []Item {
    mut out []Item = []
    for i in 0..n {
        push(&out, make_item(i))
    }
    ret out
}

fn same_ints(a []int, b []int) bool {
    if len(a) != len(b) { ret false }
    for i in 0..len(a) {
        if a[i] != b[i] { ret false }
    }
    ret true
}

fn same_strs(a []str, b []str) bool {
    if len(a) != len(b) { ret false }
    for i in 0..len(a) {
        if a[i] != b[i] { ret false }
    }
    ret true
}

fn same_items(a []Item, b []Item) bool {
    if len(a) != len(b) { ret false }
    for i in 0..len(a) {
        if a[i].id != b[i].id or a[i].name != b[i].name { ret false }
    }
    ret true
}

fn main() {
    for n in [0, 1, 2, 7, 1000, 1000000] {
        ints := par.build(n, square)
        strs := par.build(n, label)
        items := par.build(n, make_item)
        print("n {n} ints {same_ints(ints, loop_squares(n))} strs {same_strs(strs, loop_labels(n))} items {same_items(items, loop_items(n))}")
    }
}
