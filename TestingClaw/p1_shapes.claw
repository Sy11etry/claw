type Shape = Circle{r f64} | Rect{w f64, h f64} | Dot

fn area(s Shape) f64 {
    match s {
        Circle{r}: ret 3.14 * r * r
        Rect{w, h}: ret w * h
        Dot: ret 0
    }
}

fn main() {
    shapes := [Circle{1.0}, Rect{2.0, 3.0}, Dot]
    mut total := 0.0
    for s in shapes {
        total += area(s)
    }
    print("total = {total}")
}
