// expect: value 123
// expect: bad at 1
type BadNum = Empty | Bad{at int}

fn parse(s str) int ! BadNum {
    if len(s) == 0 { fail Empty }
    mut n := 0
    for i in 0..len(s) {
        c := s[i]
        if c < '0' or c > '9' { fail Bad{i} }
        n = n * 10 + int(c - '0')
    }
    ret n
}

fn main() {
    a := parse("123")?
    print("value {a}")
    _ = parse("1x3") else err {
        match err {
            Empty: print("empty")
            Bad{at}: print("bad at {at}")
        }
        ret
    }
}
