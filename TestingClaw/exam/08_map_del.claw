// expect: has x true
// expect: deleted true
// expect: has y false
// expect: has z true
fn main() {
    mut m := new_map[str, int](hash_str)
    put(&m, "x", 1)
    put(&m, "y", 2)
    put(&m, "z", 3)
    print("has x {has_key(m, "x")}")
    ok := del(&m, "y")
    print("deleted {ok}")
    print("has y {has_key(m, "y")}")
    print("has z {has_key(m, "z")}")
}
