// expect: HELLO, CLAW
// expect: true
// expect: true
// expect: at 7
// expect: Hello|Claw
fn main() {
    s := "  Hello, Claw  "
    t := trim(s)
    print(upper(t))
    print(starts_with(t, "Hello"))
    print(contains(t, "Claw"))
    at := find(t, "Claw") else -1
    print("at {at}")
    parts := split(t, ", ")
    print(join(parts, "|"))
}
