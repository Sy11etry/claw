// expect: total 19
type Shape = Square{side int} | Rect{w int, h int} | Dot

fn area(s Shape) int {
    match s {
        Square{side}: ret side * side
        Rect{w, h}: ret w * h
        Dot: ret 0
    }
}

fn main() {
    shapes := [Square{3}, Rect{2, 5}, Dot]
    mut total := 0
    for s in shapes { total += area(s) }
    print("total {total}")
}
