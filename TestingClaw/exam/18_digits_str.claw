// expect: digits 6
// expect: sum 14
fn main() {
    s := "a1b22c333"
    mut count := 0
    mut total := 0
    for i in 0..len(s) {
        c := s[i]
        if c >= '0' and c <= '9' {
            count += 1
            total += int(c - '0')
        }
    }
    print("digits {count}")
    print("sum {total}")
}
