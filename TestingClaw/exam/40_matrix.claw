// expect: c00 7
// expect: c01 10
// expect: c10 15
// expect: c11 22
fn mul(a [2][2]int, b [2][2]int) [2][2]int {
    mut r [2][2]int = [[0, 0], [0, 0]]
    for i in 0..2 {
        for j in 0..2 {
            for k in 0..2 {
                r[i][j] += a[i][k] * b[k][j]
            }
        }
    }
    ret r
}

fn main() {
    m := [[1, 2], [3, 4]]
    c := mul(m, m)
    print("c00 {c[0][0]}")
    print("c01 {c[0][1]}")
    print("c10 {c[1][0]}")
    print("c11 {c[1][1]}")
}
