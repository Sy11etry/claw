type ParseErr = Empty | Bad{at int}

fn digit(c u8) int ! ParseErr {
    if c < '0' or c > '9' { fail Bad{0} }
    ret int(c - '0')
}

fn read_num(s str) int ! ParseErr {
    if len(s) == 0 { fail Empty }
    mut n := 0
    for i in 0..len(s) {
        d := digit(s[i])?
        n = n * 10 + d
    }
    ret n
}

fn main() {
    a := read_num("123") else 0
    print("a = {a}")
    b := read_num("x1") else {
        print("bad input")
        ret
    }
    print("b = {b}")
}
