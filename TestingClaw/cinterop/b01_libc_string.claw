// c: b01_libc_string.c
// x64: yes
// expect: len 5
// expect: cmp -1
// expect: same 0
// expect: chr 119
// expect: missing -1
// expect: byte 121
use c "string.h"

claw fn sign(r i32) int {
    if r < 0 { ret -1 }
    if r > 0 { ret 1 }
    ret 0
}

claw fn length() int {
    ret int(strlen("hello"))
}

claw fn cmp_apple() int {
    ret sign(strcmp("apple", "banana"))
}

claw fn cmp_same() int {
    ret sign(strcmp("same", "same"))
}

claw fn chr_of(c i32) int {
    p := strchr("claw", c)
    if p == none { ret -1 }
    ret int(p[0])
}

claw fn copy_byte() int {
    buf := alloc[u8](4)
    defer free(buf)
    _ = memcpy(buf, "xyz", 3)
    ret int(buf[1])
}

fn main() {
    print("len {length()}")
    print("cmp {cmp_apple()}")
    print("same {cmp_same()}")
    print("chr {chr_of(i32('w'))}")
    print("missing {chr_of(i32('z'))}")
    print("byte {copy_byte()}")
}
