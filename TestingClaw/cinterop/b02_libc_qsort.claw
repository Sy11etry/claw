// c: b02_libc_qsort.c
// x64: yes
// expect: sorted 1 2 5 9
// expect: found 2
// expect: missing -1
use c "stdlib.h"

claw fn cmp_int(a *u8, b *u8) i32 {
    x := *cast[*i32](a)
    y := *cast[*i32](b)
    if x < y { ret -1 }
    if x > y { ret 1 }
    ret 0
}

claw fn sort_at(i int) int {
    p := alloc[i32](4)
    defer free(p)
    p[0] = 5
    p[1] = 2
    p[2] = 9
    p[3] = 1
    qsort(cast[*u8](p), 4, 4, cast[*u8](cmp_int))
    ret int(p[i])
}

claw fn search(key int) int {
    arr := alloc[i32](4)
    defer free(arr)
    arr[0] = 1
    arr[1] = 2
    arr[2] = 5
    arr[3] = 9
    k := alloc[i32](1)
    defer free(k)
    k[0] = i32(key)
    r := bsearch(cast[*u8](k), cast[*u8](arr), 4, 4, cast[*u8](cmp_int))
    if r == none { ret -1 }
    ret int(*cast[*i32](r))
}

fn main() {
    print("sorted {sort_at(0)} {sort_at(1)} {sort_at(2)} {sort_at(3)}")
    print("found {search(2)}")
    print("missing {search(7)}")
}
