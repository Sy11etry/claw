// c: b08_sqlite.c
// clw: -l sqlite3
// cflags: -lsqlite3
// x64: yes
// expect: rows 1000
// expect: sum 500500
// expect: exec 0
use c "sqlite3.h"

claw fn parse_int(p *u8) int {
    mut v := 0
    mut i := 0
    for p[i] != 0 {
        v = v * 10 + int(p[i] - '0')
        i += 1
    }
    ret v
}

claw fn on_row(arg *u8, _ i32, vals **u8, _ **u8) i32 {
    acc := cast[*int](arg)
    acc[0] += 1
    acc[1] += parse_int(vals[0])
    ret 0
}

claw fn query(which int) int {
    mut db *u8 = none
    if sqlite3_open(":memory:", &db) != 0 { ret -1 }
    _ = sqlite3_exec(db, "CREATE TABLE t(x INTEGER); WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<1000) INSERT INTO t SELECT x FROM c;", none, none, none)
    acc := alloc[int](2)
    defer free(acc)
    acc[0] = 0
    acc[1] = 0
    rc := sqlite3_exec(db, "SELECT x FROM t", cast[*u8](on_row), cast[*u8](acc), none)
    _ = sqlite3_close(db)
    if which == 0 { ret acc[0] }
    if which == 1 { ret acc[1] }
    ret int(rc)
}

fn main() {
    print("rows {query(0)}")
    print("sum {query(1)}")
    print("exec {query(2)}")
}
