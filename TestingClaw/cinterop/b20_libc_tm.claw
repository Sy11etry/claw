// c: b20_libc_tm.c
// x64: yes
// expect: year 70
// expect: mon 0
// expect: mday 1
// expect: hour 0
use c "time.h"

claw fn field(which int) int {
    t := alloc[i64](1)
    defer free(t)
    t[0] = 0
    tmp := gmtime(t)
    if tmp == none { ret -1 }
    if which == 0 { ret int(tmp.tm_year) }
    if which == 1 { ret int(tmp.tm_mon) }
    if which == 2 { ret int(tmp.tm_mday) }
    ret int(tmp.tm_hour)
}

fn main() {
    print("year {field(0)}")
    print("mon {field(1)}")
    print("mday {field(2)}")
    print("hour {field(3)}")
}
