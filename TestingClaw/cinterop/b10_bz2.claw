// c: b10_bz2.c
// clw: -l bz2
// cflags: -lbz2
// x64: yes
// expect: ok 1
// expect: smaller 1
use c "bzlib.h"

claw fn roundtrip(n int) int {
    src := alloc[u8](n)
    defer free(src)
    for i in 0..n {
        src[i] = u8(i % 11)
    }
    cap := n + n / 10 + 1024
    dst := alloc[u8](cap)
    defer free(dst)
    mut dlen := u32(cap)
    rc := BZ2_bzBuffToBuffCompress(dst, &dlen, src, u32(n), 9, 0, 30)
    back := alloc[u8](n)
    defer free(back)
    mut blen := u32(n)
    rc2 := BZ2_bzBuffToBuffDecompress(back, &blen, dst, dlen, 0, 0)
    if rc != 0 or rc2 != 0 { ret -1 }
    if blen != u32(n) { ret -2 }
    for i in 0..n {
        if back[i] != src[i] { ret -3 }
    }
    ret 1
}

claw fn compressed_size(n int) int {
    src := alloc[u8](n)
    defer free(src)
    for i in 0..n {
        src[i] = u8(i % 11)
    }
    cap := n + n / 10 + 1024
    dst := alloc[u8](cap)
    defer free(dst)
    mut dlen := u32(cap)
    _ = BZ2_bzBuffToBuffCompress(dst, &dlen, src, u32(n), 9, 0, 30)
    if dlen < u32(n) { ret 1 }
    ret 0
}

fn main() {
    print("ok {roundtrip(100000)}")
    print("smaller {compressed_size(100000)}")
}
