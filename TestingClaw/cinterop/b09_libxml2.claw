// c: b09_libxml2.c
// clw: -l xml2 -I /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/libxml2
// cflags: -I/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/libxml2 -lxml2
// x64: yes
// expect: len 5
// expect: cmp -1
// expect: root 1
use c "libxml/parser.h"

claw fn sign(r i32) int {
    if r < 0 { ret -1 }
    if r > 0 { ret 1 }
    ret 0
}

claw fn len_of() int {
    ret int(xmlStrlen("hello"))
}

claw fn cmp_of() int {
    ret sign(xmlStrcmp("abc", "abd"))
}

claw fn root_ok() int {
    doc := xmlReadMemory("<a><b/></a>", 11, none, none, 0)
    if doc == none { ret -1 }
    mut ok := 0
    if xmlDocGetRootElement(doc) != none { ok = 1 }
    xmlFreeDoc(doc)
    ret ok
}

fn main() {
    print("len {len_of()}")
    print("cmp {cmp_of()}")
    print("root {root_ok()}")
}
