// c: b12_iconv.c
// clw: -l iconv
// cflags: -liconv
// x64: yes
// expect: bytes 4
// expect: first 104
use c "iconv.h"

claw fn convert(which int) int {
    cd := iconv_open("UTF-16LE", "UTF-8")
    if cd == none { ret -1 }
    src := alloc[u8](2)
    defer free(src)
    src[0] = 'h'
    src[1] = 'i'
    dst := alloc[u8](8)
    defer free(dst)
    mut inp *u8 = src
    mut inleft := u64(2)
    mut outp *u8 = dst
    mut outleft := u64(8)
    _ = iconv(cd, &inp, &inleft, &outp, &outleft)
    _ = iconv_close(cd)
    if which == 0 { ret int(u64(8) - outleft) }
    ret int(dst[0])
}

fn main() {
    print("bytes {convert(0)}")
    print("first {convert(1)}")
}
