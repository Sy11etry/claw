fn main() {
    text := "the cat and the dog and the bird"
    mut m := new_map[str, int](hash_str)
    for w in split(text, " ") {
        c := get(m, w) else 0
        put(&m, copy(w), c + 1)
    }
    t := get(m, "the") else 0
    a := get(m, "and") else 0
    c := get(m, "cow") else 0
    print("the = {t}, and = {a}, cow = {c}")
}
