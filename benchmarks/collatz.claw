fn steps(start int) int {
    mut n := start
    mut c := 0
    for n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        c += 1
    }
    ret c
}

fn main() {
    mut best := 0
    for i in 1..2000000 {
        s := steps(i)
        if s > best { best = s }
    }
    print(best)
}
