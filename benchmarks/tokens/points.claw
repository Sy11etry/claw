type Point { x int, y int }

fn add(a Point, b Point) Point {
    ret Point{a.x + b.x, a.y + b.y}
}

fn dist2(a Point, b Point) int {
    dx := a.x - b.x
    dy := a.y - b.y
    ret dx * dx + dy * dy
}

fn main() {
    p := Point{1, 2}
    q := Point{4, 6}
    r := add(p, q)
    print("{r.x} {r.y}")
    print(dist2(p, q))
}
