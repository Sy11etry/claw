type Stack { items []int }

fn push_on(s &Stack, x int) {
    push(&s.items, x)
}

fn pop_off(s &Stack) ?int {
    ret pop(&s.items)
}

fn main() {
    mut s := Stack{[]}
    push_on(&s, 1)
    push_on(&s, 2)
    print(pop_off(&s) else -1)
    print(pop_off(&s) else -1)
    print(pop_off(&s) else -1)
}
